{% extends 'emails/base.html.twig' %}

{% block title %}Confirm your email address{% endblock %}

{% block content %}
<div style="background:#eaf7ff;border:1px solid #bfdbfe;border-radius:14px;padding:20px;margin-bottom:24px;">
    <strong style="font-size:16px;color:#0f172a;">✅ Confirm your email address</strong>
</div>

<h1 style="font-size:24px;color:#111827;margin:0 0 16px;">Thank you for signing up!</h1>
<p style="font-size:15px;color:#475569;line-height:1.7;margin:0 0 24px;">
    Click the button below to verify your email address and activate your account.
</p>

<a href="{{ signedUrl|raw }}"
   style="display:inline-block;background:#1a1a2e;color:#ffffff;padding:14px 26px;border-radius:10px;text-decoration:none;font-weight:600;">
    Confirm my email →
</a>

<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:16px;margin-top:24px;">
    <p style="font-size:13px;color:#475569;margin:0;">
        This link expires in <strong>{{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}</strong>.
    </p>
</div>

<p style="font-size:13px;color:#64748b;margin-top:24px;line-height:1.6;">
    If the button doesn't work, copy and paste this link:<br>
    <span style="color:#1a1a2e;font-size:13px;word-break:break-all;">{{ signedUrl|raw }}</span>
</p>
{% endblock %}
