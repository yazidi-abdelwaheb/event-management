{% extends 'emails/base.html.twig' %}

{% block title %}Event registration confirmation{% endblock %}

{% block content %}
<div style="background:#dcfce7;border:1px solid #bbf7d0;border-radius:14px;padding:20px;margin-bottom:24px;">
    <strong style="font-size:16px;color:#0f5132;">✅ Registration confirmed</strong>
</div>

<h1 style="font-size:24px;color:#111827;margin:0 0 16px;">Your seat is reserved!</h1>
<p style="font-size:15px;color:#475569;line-height:1.7;margin:0 0 24px;">
    Your registration for the event <strong>{{ event.getTitle() }}</strong> has been confirmed.
</p>

<table width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:24px;">
    <tr>
        <td style="padding:20px;">
            <p style="margin:0 0 10px;font-size:12px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.5px;">Start date</p>
            <p style="margin:0 0 12px;font-size:14px;color:#111827;font-weight:600;">{{ event.getStartDateTime()|date('l d F Y · H:i') }}</p>

            {% if event.getEndDateTime() %}
                <p style="margin:0 0 10px;font-size:12px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.5px;">End date</p>
                <p style="margin:0 0 12px;font-size:14px;color:#111827;font-weight:600;">{{ event.getEndDateTime()|date('l d F Y · H:i') }}</p>
            {% endif %}

            <p style="margin:0 0 10px;font-size:12px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.5px;">Location</p>
            <p style="margin:0 0 12px;font-size:14px;color:#111827;font-weight:600;">{{ event.getLocation() }}</p>

            <p style="margin:0 0 10px;font-size:12px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.5px;">Registration number</p>
            <p style="margin:0;font-size:14px;color:#111827;font-weight:700;font-family:monospace;">#{{ '%06d'|format(subscription.getId()) }}</p>
        </td>
    </tr>
</table>

<div style="text-align:center;margin-bottom:24px;">
    <p style="font-size:14px;color:#1a1a2e;font-weight:700;margin:0 0 10px;">Your QR Code</p>
    <div style="display:inline-block;background:white;padding:18px;border-radius:16px;border:1px solid #e5e7eb;">
        <img src="{{ qrUrl }}" alt="QR Code ticket" width="180" height="180" style="display:block;border-radius:12px;" />
    </div>
</div>

<div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:12px;padding:18px;">
    <p style="font-size:13px;color:#0c4a6e;margin:0;line-height:1.6;">
        Please present this QR code at the event entrance.<br>
        If you have any questions, contact our team.
    </p>
</div>
{% endblock %}
