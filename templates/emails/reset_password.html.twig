{% extends 'emails/base.html.twig' %}

{% block title %}Password reset request{% endblock %}

{% block content %}
<div style="background:#fef3c7;border:1px solid #fde68a;border-radius:14px;padding:20px;margin-bottom:24px;">
    <strong style="font-size:16px;color:#92400e;">🔑 Password reset request</strong>
</div>

<h1 style="font-size:24px;color:#111827;margin:0 0 16px;">Reset your password</h1>
<p style="font-size:15px;color:#475569;line-height:1.7;margin:0 0 28px;">
    We received a request to reset the password for your account. Click the button below to choose a new password.
</p>

<a href="{{ url('app_reset_password', {token: resetToken.token}) }}"
   style="display:inline-block;background:#1a1a2e;color:#ffffff;padding:14px 26px;border-radius:10px;text-decoration:none;font-weight:600;">
    Reset my password →
</a>

<div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:12px;padding:16px;margin-top:24px;">
    <p style="font-size:13px;color:#0c4a6e;margin:0;">
        This link expires in <strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
    </p>
</div>

<p style="font-size:13px;color:#64748b;margin-top:24px;line-height:1.6;">
    If the button doesn't work, copy and paste this link into your browser:<br>
    <a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="color:#1a1a2e;font-size:13px;word-break:break-all;">
        {{ url('app_reset_password', {token: resetToken.token}) }}
    </a>
</p>
{% endblock %}
